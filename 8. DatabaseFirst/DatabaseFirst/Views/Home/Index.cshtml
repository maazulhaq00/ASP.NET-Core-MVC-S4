@model List<Student>
@{
    ViewData["Title"] = "Home Page";
}



<div class="container">

    @if (TempData["success_message"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["success_message"]
        </div>
    }
<h1 class="display-4">Students</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Student Image</th>
            <th scope="col">Student Name</th>
            <th scope="col">Age</th>
            <th scope="col">Email</th>
            <th scope="col">Action</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <th scope="row">@s.StudentId</th>
                <td>
                    <img src="~/images/@s.StudentImage" alt="Alternate Text" width="200" />
                </td>
                <td>@s.StudentName</td>
                <td>@s.StudentAge</td>
                <td>@s.StudentEmail</td>
                <td>
                        <a class="btn btn-dark" asp-controller="Home" asp-action="EditStudent" asp-route-id="@s.StudentId" >Edit</a>
                        <a class="btn btn-danger" asp-controller="Home" asp-action="DeleteStudent" asp-route-id="@s.StudentId">Delete</a>
                </td>
            </tr>
        }
        
        
    </tbody>
</table>

</div>
