@model Student

@{
}

<div class="container">
    <h1 class="display-4">Add Student</h1>

    <form method="post" asp-controller="Home" asp-action="AddStudent" >
        <div class="mb-3">
            <label class="form-label" asp-for="StudentName"></label>
            <input class="form-control" asp-for="StudentName">
            <span asp-validation-for="StudentName" style="color: red;" ></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="StudentAge"></label>
            <input class="form-control" asp-for="StudentAge">
            <span asp-validation-for="StudentAge" style="color: red;"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="StudentEmail"></label>
            <input class="form-control" asp-for="StudentEmail">
            <span asp-validation-for="StudentEmail" style="color: red;"></span>
        </div>

        <button type="submit" class="btn btn-dark" >Add</button>
    </form>


</div>

