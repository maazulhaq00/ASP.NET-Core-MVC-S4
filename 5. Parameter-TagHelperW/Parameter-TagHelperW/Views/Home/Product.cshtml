@{
    ViewData["Title"] = "Contact Page";


}
<div class="container">
    <h1 class="display-4">Product</h1>

    <div class="card" style="width: 18rem;">
        <div class="card-body">
            <h6 class="card-subtitle mb-2 text-body-secondary">#@ViewBag.id</h6>

            <h5 class="card-title">@ViewBag.name</h5>
            <p class="card-text">Rs. @ViewBag.price</p>
      </div>
    </div>
</div>
